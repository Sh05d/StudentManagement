<?xml version="1.0" encoding="UTF-8"?>
 
<Configuration status="WARN">
 
    <Appenders>
    
        <!-- File Appender -->
        <File name="ApplicationFile"
              fileName="logs/application.log">
            <PatternLayout
                pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %c{1} - %msg%n"/>
        </File>
        
                <!-- Error File Appender -->
        <File name="ErrorFile"
              fileName="logs/error.log">
            <PatternLayout
                pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %c{1} - %msg%n"/>
        </File>
 
    </Appenders>
 
    <Loggers>
 
        <Root level="debug">
 
            <AppenderRef ref="ApplicationFile"/>
            <AppenderRef ref="ErrorFile" level="error"/>
            
        </Root>
 
    </Loggers>
 
</Configuration>
